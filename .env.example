# Get your free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Your Real-Debrid token (from Torrentio config)
RD_TOKEN=your_rd_token_here

# A secret passphrase to protect the /api/watch endpoint
# Choose any string — you'll enter this in the PWA on first use
APP_SECRET=choose_a_secret_here
